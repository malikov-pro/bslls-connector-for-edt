{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "eclipse-ide": {
      "type": "local",
      "command": [
        "npx",
        "\t-y",
        "\tmcp-remote",
        "\thttp://127.0.0.1:8080/mcp/eclipse-ide",
        "\t--allow-http",
        "\t--header \"Authorization: Bearer \"{env:API_KEY}\"\""
      ],
      "environment": {
        "API_KEY": "ede8a251-2c99-4b45-adf0-1b365df128bf"
      },
      "enabled": true
    }
  }
}