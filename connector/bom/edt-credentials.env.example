# Заготовка для учётки edt.1c.ru (не Maven Central).
# Скопируйте в edt-credentials.env и заполните. Файл с паролем в git не кладите.
#
#   cp bom/edt-credentials.env.example bom/edt-credentials.env
#   source bom/edt-credentials.env
#   mvn verify -s bom/settings.xml -Dtycho.localArtifacts=ignore
#
# ${env.MAVEN_USERNAME} в settings.xml — это переменные окружения процесса,
# не путь к файлу. Maven сам их не читает из .env, нужен source/export.

export MAVEN_USERNAME='логин_edt.1c.ru'
export MAVEN_CENTRAL_TOKEN='пароль_edt.1c.ru'
